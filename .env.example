# ========================================================
# STOKIFY - ENVIRONMENT CONFIGURATION (.env atau .env.local)
# ========================================================

# 1. DATABASE LOKAL (DEFAULT - File SQLite di root server)
# Cukup gunakan ini tanpa konfigurasi server database tambahan:
DATABASE_URL=file:./stokify.db

# 2. REMOTE LIB-SQL / TURSO CLOUD (OPSIONAL - Jika database terpisah di cloud)
# DATABASE_URL=libsql://nama-db-anda.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# 3. GOOGLE SHEETS MASTER KATALOG (OPSIONAL)
GOOGLE_SHEET_ID=1-LakqsOxhn3jbUaizBuLjNVRk_0K8B8xbBLe0RmidaU

# 4. PORT SERVER (OPSIONAL, default Next.js: 3000)
PORT=3000
