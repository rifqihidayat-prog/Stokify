# ========================================================
# STOKIFY - ENVIRONMENT CONFIGURATION (salin ke .env.local)
# Jangan isi secret di .env — file itu ikut ter-commit ke repo.
# ========================================================

# 1. DATABASE LOKAL (DEFAULT - File SQLite di root project)
DATABASE_URL=file:./stokify.db

# 2. REMOTE LIB-SQL / TURSO CLOUD (OPSIONAL)
# DATABASE_URL=libsql://nama-db-anda.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# 3. FOLDER FOTO LAMPIRAN (uploads/). Default: ./data
DATA_DIR=./data

# 4. WAJIB DI PRODUCTION: kunci tanda tangan cookie sesi (min 32 karakter)
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# 5. ADMIN PERTAMA — dibuat otomatis saat server start bila tabel users masih kosong
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 6. GOOGLE SHEETS MASTER KATALOG (OPSIONAL)
GOOGLE_SHEET_ID=1-LakqsOxhn3jbUaizBuLjNVRk_0K8B8xbBLe0RmidaU

# 7. PORT SERVER (OPSIONAL, default Next.js: 3000)
PORT=3000
