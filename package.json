{
  "name": "stokify",
  "version": "1.0.0",
  "private": true,
  "description": "Stokify - Sistem Monitoring Stok Pusat & Pengajuan Toko",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
